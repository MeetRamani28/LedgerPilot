# Environment
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Database (sqlite | postgres)
DB_PROVIDER=sqlite
DATABASE_URL=sqlite+aiosqlite:///./ledgerpilot.db

# Storage (local | supabase)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invoices

# Vector Store (chroma | pinecone)
VECTOR_PROVIDER=chroma
CHROMA_PERSIST_DIR=./chroma_db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ledgerpilot-vendors

# Extraction Provider (groq | cohere | mock)
EXTRACTION_PROVIDER=mock
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
COHERE_API_KEY=

# Clerk Authentication (Multi-device persistent session verification)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
